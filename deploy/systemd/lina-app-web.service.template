[Unit]
Description=Lina web interface
Requires=lina-app-codex.service
After=lina-app-codex.service network-online.target
StartLimitIntervalSec=60
StartLimitBurst=8

[Service]
Type=exec
WorkingDirectory=%h/code/Lina
UMask=0077
Environment="PATH=%h/node/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.bun/bin/bun packages/lina-web/scripts/start.ts
Restart=always
RestartSec=3s
TimeoutStopSec=15s

[Install]
WantedBy=default.target
