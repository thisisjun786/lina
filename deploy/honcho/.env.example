# Lina self-hosted Honcho connection. Leave ALL of these unset to keep memory disabled.
# A partially filled set is a startup error, never a silent fallback.

# Operator-run Honcho origin only. Managed hosts (api.honcho.dev) are refused.
# Must sit behind a private boundary (loopback, Tailscale, private network).
LINA_HONCHO_BASE_URL=http://127.0.0.1:8000

# Lina-only names, ^[a-zA-Z0-9_-]{1,512}$. Never reuse BUZZ workspaces or peers.
LINA_HONCHO_WORKSPACE_ID=lina
LINA_HONCHO_SESSION_ID=lina-main
LINA_HONCHO_USER_PEER_ID=example-user
LINA_HONCHO_OBSERVER_PEER_ID=lina

# Only when the server runs with AUTH.USE_AUTH=true. Keep out of git and chat.
# LINA_HONCHO_API_KEY=
