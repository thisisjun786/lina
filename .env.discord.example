# Shell-free KEY=VALUE format: blank/comment lines are skipped; matching outer quotes are removed.
# Values are never evaluated, and everything after the first '=' is preserved.
# Required Discord bridge settings
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
LINA_DISCORD_ALLOWED_USER_IDS=

# Local Lina intervention socket
LINA_INTERVENTION_URL=ws://127.0.0.1:7979
LINA_INTERVENTION_PORT=7979
LINA_DISCORD_GATEWAY=on
LINA_DISCORD_CATCHUP_MS=60000
LINA_DISCORD_REST_API=https://discord.com/api/v10
LINA_DISCORD_CURSOR_PATH=.lina-sync/discord-cursor.json

# Optional runtime settings
LINA_MODEL=openai-codex/gpt-5.6-sol
LINA_THINKING=high
