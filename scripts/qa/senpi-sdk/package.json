		"lint": "biome check ."
	},
	"dependencies": {
		"@code-yeongyu/senpi": "2026.9.10-2",
		"typebox": "1.3.18",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"bun-types": "1.3.10",
		"typescript": "5.9.3"
	}
}
