{
	"name": "lina-qa-senpi-sdk",
	"private": true,
	"type": "module",
	"version": "0.0.0",
	"scripts": {
		"qa": "bun run cli.ts",
		"check": "bun test ./*.check.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
